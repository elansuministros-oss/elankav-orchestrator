# ELANKAV Langflow POC
# Copy to .env on the server. Never commit the real values.

LANGFLOW_SUPERUSER=elan-admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
LANGFLOW_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# The existing OpenAI credential may be injected by the supervisor/runtime.
# Do not copy credentials into Git.
OPENAI_API_KEY=

# Initial CONNECT read-only POC target from inside Docker.
ELANKAV_CONNECT_INTERNAL_URL=http://host.docker.internal:4400

# Existing CONNECT internal credentials are injected at deploy time only.
# Do not place real values in this file.
VQS_API_TOKEN=
CONNECT_INTERNAL_API_TOKEN=
