# ELANKAV Langflow POC
# Reference only. Production secrets are generated by Owner Ops supervisor
# at /var/lib/elankav-langflow/langflow.env and never committed.

LANGFLOW_SUPERUSER=elan-admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
LANGFLOW_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
LANGFLOW_API_KEY_SOURCE=env
LANGFLOW_API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY

# Model/provider credentials are NOT required merely to boot Langflow.
# Final ELAN execution will inject runtime credentials from Orchestrator,
# not duplicate them permanently in Git.
OPENAI_API_KEY=

ELANKAV_CONNECT_INTERNAL_URL=http://host.docker.internal:4400
VQS_API_TOKEN=
CONNECT_INTERNAL_API_TOKEN=
