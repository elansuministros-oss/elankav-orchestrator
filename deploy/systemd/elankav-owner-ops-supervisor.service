[Unit]
Description=ELANKAV Owner Ops External Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/elankav/orchestrator
ExecStart=/usr/bin/node /opt/elankav/orchestrator/bin/owner-ops-supervisor.js
Restart=always
RestartSec=2
UMask=0077
Environment=NODE_ENV=production
Environment=OWNER_OPS_SUPERVISOR_DIR=/var/lib/elankav-owner-ops
Environment=WHATSAPP_CORE_PROTECTED=true
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=false

[Install]
WantedBy=multi-user.target
